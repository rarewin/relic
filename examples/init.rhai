// ============================================================
// Relic Editor Configuration Script (init.rhai)
// ============================================================
// このファイルを ~/.config/relic/init.rhai に配置することで、
// 起動時に自動的に読み込まれて実行されます。
//
// Rhai は Rust 製のシンプルでモダンな組み込みスクリプト言語です。
// Kotlin や Swift、JavaScript に似た直感的な文法でエディタを拡張できます。

// 起動時の初期化処理フック
fn init() {
    // 起動時にエコーエリアへウェルカムメッセージとバージョンを表示
    let ver = version();
    set_message("✨ Relic v" + ver + " initialized with Rhai plugin engine!");
}

// ------------------------------------------------------------
// 設定例 1: スマートな行頭移動 (make C-a lovely)
// ------------------------------------------------------------
// Emacs の以下の設定と同等の機能です:
//   (define-key global-map "\C-a"
//     #'(lambda (arg)
//         (interactive "p")
//         (if (looking-at "^")
//             (back-to-indentation)
//           (beginning-of-line arg))))
//
// 行の途中から C-a を押すと真の行頭 (col 0) へ移動し、
// 行頭でもう一度 C-a を押すとインデント位置 (最初の非空白文字) へ移動します。
fn lovely_beginning_of_line() {
    if looking_at("^") {
        back_to_indentation();
    } else {
        beginning_of_line();
    }
}

// C-a のキーバインドに割り当て
define_key("C-a", "lovely_beginning_of_line");

// ------------------------------------------------------------
// 設定例 2: カスタム関数とテキスト挿入
// ------------------------------------------------------------
fn insert_sample_header() {
    insert_text("// ----------------------------------------\n// Generated by Relic Custom Plugin\n// ----------------------------------------\n");
}

fn jump_to_start() {
    move_cursor(0, 0);
    set_message("Jumped to top of buffer");
}

// 初期化フックを実行
init();
